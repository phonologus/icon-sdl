#  Makefile definitions for Macintosh with the SDL3 + Blend2D graphics
#  backend (icon-sdl fork).
#
#  CC       C compiler
#  CFLAGS   flags for building C files
#  CFDYN    additional flags for dynamic functions
#  RLINK    flags for linking run-time system
#  RLIBS    libraries to link with run-time system
#  TLIBS    libraries to link for POSIX threads
#  XLIBS    libraries to link for graphics
#  SFLAGS   flags for stripping iconx
#  XDEPS    files iconx must be relinked after (icon-sdl addition)
#
#  XLIBS links src/sdl's library and the vendored SDL3 and Blend2D (built
#  statically from deps/ by src/sdl/Makefile), the macOS frameworks they
#  use, and the C++ runtime Blend2D needs. Paths are relative to
#  src/runtime, where iconx is linked.

CC = cc
CFLAGS = -O
CFDYN =
RLINK = -dynamic
RLIBS = -lm
TLIBS =
SDLB = ../sdl/build
XLIBS = ../sdl/libiconsdl.a $(SDLB)/cmake/sdl3/libSDL3.a \
	$(SDLB)/cmake/blend2d/libblend2d.a -lc++ -lobjc \
	-framework Cocoa -framework Carbon -framework CoreFoundation \
	-framework CoreGraphics -framework CoreServices -framework CoreText \
	-framework CoreVideo -framework CoreMedia -framework Foundation \
	-framework IOKit -framework Metal -framework QuartzCore \
	-weak_framework UniformTypeIdentifiers
SFLAGS = -Sx
XDEPS = ../sdl/libiconsdl.a
