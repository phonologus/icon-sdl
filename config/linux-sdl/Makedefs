#  Makefile definitions for Linux with the SDL3 + Blend2D graphics
#  backend (icon-sdl fork).
#
#  CC       C compiler
#  CFLAGS   flags for building C files
#  CFDYN    additional flags for dynamic functions
#  RLINK    flags for linking run-time system
#  RLIBS    libraries to link with run-time system
#  TLIBS    libraries to link for POSIX threads
#  XLIBS    libraries to link for graphics
#  XDEPS    files iconx must be relinked after (icon-sdl addition)
#
#  XLIBS links src/sdl's library and the vendored SDL3 and Blend2D (built
#  statically from deps/ by src/sdl/Makefile), fontconfig, and the C++
#  runtime Blend2D needs. SDL loads X11 or Wayland itself at run time.
#  Paths are relative to src/runtime, where iconx is linked.

CC = gcc
CFLAGS = -O
CFDYN = -fPIC
RLINK = -Wl,-E
RLIBS = -lm -ldl
TLIBS = -lpthread
SDLB = ../sdl/build
XLIBS = ../sdl/libiconsdl.a $(SDLB)/cmake/sdl3/libSDL3.a \
	$(SDLB)/cmake/blend2d/libblend2d.a -lfontconfig -lstdc++ -lm -ldl -lpthread
XDEPS = ../sdl/libiconsdl.a
