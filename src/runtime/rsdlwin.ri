/*
 * ---------------------------------------------------------------------
 * Helpers
 * ---------------------------------------------------------------------
 */

/* The canvas of w, or NULL if the window is not yet mapped. */
#define CANVAS(w) ((w)->window->canvas)

/* Fill in the per-call graphics state from w's context. */
static void mkgc(wbp w, sdlgc *g)
   {
   wcp wc = w->context;
   g->fg = wc->fg;
   g->bg = wc->bg;
   g->drawop = wc->drawop;
   g->reverse = ISXORREVERSE(w) != 0;
   g->linewidth = wc->linewidth;
   g->linestyle = wc->linestyle;
   g->fillstyle = wc->fillstyle;
   g->patw = wc->patw;
   g->path = wc->path;
   g->pat = wc->pat;
   g->clipx = wc->clipx;
   g->clipy = wc->clipy;
   g->clipw = wc->clipw;
   g->cliph = wc->cliph;
   }

static int nwins = 0;			/* windows open (not hidden canvases) */
static unsigned long lastpresent;	/* when canvases were last shown */

/* The platform state for an Icon window state. */
static int plstate(int iconic)
   {
   switch (iconic) {
   case HiddenState:	return PL_HIDDEN;
   case IconicState:	return PL_ICONIC;
   case MaximizedState:	return PL_MAXIMAL;
   default:		return PL_NORMAL;
   }
   }

/*
 * sdl_unmap() - release a window state's window (not its canvas).
 */
void sdl_unmap(wsp ws)
   {
   if (ws->win) {
      pl_close(ws->win);
      ws->win = NULL;
      nwins--;
      }
   }

/*
 * present() - show what changed in each window's canvas.
 */
static void present(int full)
   {
   wsp ws;
   for (ws = wstates; ws; ws = ws->next)
      if (ws->win && ws->canvas)
	 pl_present(ws->win, ws->canvas, ws->width, ws->height, full);
   lastpresent = millisec();
   }

/*
 * mkwin() - make the platform window for ws (which has a canvas, or is
 * about to: *scale receives the scale for it).
 */
static int mkwin(wbp w, int *scale)
   {
   wsp ws = w->window;
   ws->win = pl_open(ws->windowlabel ? ws->windowlabel : "",
      ws->posx == -(MaxInt) ? PL_NOPOS : ws->posx,
      ws->posy == -(MaxInt) ? PL_NOPOS : ws->posy,
      ws->width, ws->height, plstate(ws->iconic), ISRESIZABLE(w) != 0, scale);
   if (ws->win == NULL)
      return Failed;
   nwins++;
   if (ws->iconpx)
      pl_icon(ws->win, ws->iconpx, ws->iconpw, ws->iconph);
   return Succeeded;
   }

/* show a newly made window and its canvas */
static void showwin(wbp w)
   {
   wsp ws = w->window;
   pl_present(ws->win, ws->canvas, ws->width, ws->height, 1);
   pl_state(ws->win, plstate(ws->iconic));
   SETEXPOSED(w);
   }

/*
 * wmap() - make the canvas and, unless it is hidden, the window for w.
 */
static int wmap(wbp w)
   {
   wsp ws = w->window;
   wcp wc = w->context;
   sdlgc g;
   int r, scale = 1;
   struct imgdata *imd;

   if (ws->iconic != HiddenState && ws->win == NULL)
      if (mkwin(w, &scale) != Succeeded)
	 return Failed;

   if (ws->canvas == NULL) {
      ws->canvas = cv_new(ws->width, ws->height, scale, wc->bg);
      if (ws->canvas == NULL)
	 return Failed;
      ws->pixwidth = ws->width;
      ws->pixheight = ws->height;
      }

   /* an initial image= from a file src/sdl could read */
   if (ws->initpix) {
      unsigned char *opaque = malloc(ws->initw * ws->inith);
      int i;
      if (opaque) {
	 for (i = 0; i < ws->initw * ws->inith; i++)
	    opaque[i] = (ws->initpix[i] >> 24) >= 128;
	 mkgc(w, &g);
	 g.clipw = -1;
	 cv_write(ws->canvas, &g, 0, 0, ws->initw, ws->inith, ws->initpix, opaque);
	 free(opaque);
	 }
      free(ws->initpix);
      ws->initpix = NULL;
      }

   /* an initial image= from a GIF file (read by the generic code) */
   imd = &ws->initimage;
   if (imd->width) {
      r = strimage(w, 0, 0, imd->width, imd->height, imd->paltbl,
	 imd->data, (word)imd->width * (word)imd->height, 0);
      free((pointer)imd->paltbl);
      free((pointer)imd->data);
      imd->width = 0;
      if (r < 0)
	 return Failed;
      }
   imd = &ws->initicon;
   if (imd->width) {
      free((pointer)imd->paltbl);
      free((pointer)imd->data);
      imd->width = 0;
      }
   if (wc->patternname != NULL)
      if (SetPattern(w, wc->patternname, strlen(wc->patternname)) != Succeeded)
	 return Failed;
   if (ws->win)
      showwin(w);
   return Succeeded;
   }

/*
 * ---------------------------------------------------------------------
 * Opening, closing, events
 * ---------------------------------------------------------------------
 */

/*
 * Mouse buttons in the order last pressed, as rxwin.ri's handle_mouse
 * keeps them: a drag reports the most recently pressed button.
 */
static int buttonorder[3] = { 1, 2, 3 };
static int presscount = 0;

static void btn_front(int b)
   {
   int i, j;
   for (i = 0; i < 3 && buttonorder[i] != b; i++) ;
   for (j = i; j > 0; j--)
      buttonorder[j] = buttonorder[j - 1];
   buttonorder[0] = b;
   }

static void btn_back(int b)
   {
   int i, j;
   for (i = 0; i < 3 && buttonorder[i] != b; i++) ;
   for (j = i; j < 2; j++)
      buttonorder[j] = buttonorder[j + 1];
   buttonorder[2] = b;
   }

/*
 * process_events() - move the platform layer's queued events into the
 * windows' Icon event lists. Returns -1 if a window was closed by the
 * user (X reports that as run-time error 141), else 1.
 */
static int process_events()
   {
   pl_event e;
   wsp ws;
   struct descrip d;
   int code, rv = 1;

   while (pl_poll(&e)) {
      for (ws = wstates; ws; ws = ws->next)
	 if (ws->win && ws->win == e.win)
	    break;
      if (ws == NULL)
	 continue;			/* window already gone */
      switch (e.kind) {
      case PL_KEYCHAR:
	 StrLen(d) = 1;
	 StrLoc(d) = (char *)&allchars[e.code & 0xFF];
	 ws->pointerx = e.x;
	 ws->pointery = e.y;
	 qevent(ws, &d, e.x, e.y, (uword)e.ms, e.mods);
	 break;
      case PL_KEYSYM:
	 MakeInt(e.code, &d);
	 ws->pointerx = e.x;
	 ws->pointery = e.y;
	 qevent(ws, &d, e.x, e.y, (uword)e.ms, e.mods);
	 break;
      case PL_PRESS:
      case PL_RELEASE:
	 if (e.kind == PL_PRESS) {
	    presscount++;
	    btn_front(e.code);
	    code = MOUSELEFT - (e.code - 1);
	    }
	 else {
	    if (--presscount < 0) presscount = 0;
	    btn_back(e.code);
	    code = MOUSELEFTUP - (e.code - 1);
	    }
	 ws->pointerx = e.x;
	 ws->pointery = e.y;
	 MakeInt(code, &d);
	 qevent(ws, &d, e.x, e.y, (uword)e.ms, e.mods);
	 break;
      case PL_MOTION:
	 ws->pointerx = e.x;
	 ws->pointery = e.y;
	 if (presscount == 0)
	    break;
	 MakeInt(MOUSELEFTDRAG - (buttonorder[0] - 1), &d);
	 qevent(ws, &d, e.x, e.y, (uword)e.ms, e.mods);
	 break;
      case PL_RESIZE: {			/* as rxwin.ri's handle_config */
	 wbp wb;
	 for (wb = wbndngs; wb && wb->window != ws; wb = wb->next) ;
	 if (wb == NULL)
	    break;
	 if (ws->x > e.x - FWIDTH(wb)) ws->x = e.x - FWIDTH(wb);
	 if (ws->y > e.y) ws->y = e.y;
	 if (e.x == (int)ws->width && e.y == (int)ws->height)
	    break;
	 ws->width = e.x;
	 ws->height = e.y;
	 cv_resize(ws->canvas, e.x, e.y, wb->context->bg);
	 if (e.x > ws->pixwidth) ws->pixwidth = e.x;
	 if (e.y > ws->pixheight) ws->pixheight = e.y;
	 pl_present(ws->win, ws->canvas, ws->width, ws->height, 1);
	 if (ISEXPOSED(wb)) {
	    MakeInt(RESIZED, &d);
	    qevent(ws, &d, ws->width, ws->height, ~(uword)0, 0);
	    }
	 break;
	 }
      case PL_MOVE:
	 ws->posx = e.x;
	 ws->posy = e.y;
	 break;
      case PL_EXPOSE:
	 ws->bits |= 256;			/* SETEXPOSED */
	 break;
      case PL_STATE:
	 ws->iconic = e.code == PL_ICONIC ? IconicState :
	    (e.code == PL_MAXIMAL ? MaximizedState : NormalState);
	 break;
      case PL_CLOSE:
	 rv = -1;
	 break;
	 }
      }
   return rv;
   }

/*
 * pollevent() is called by the interpreter every few hundred
 * instructions in any graphics build. With no windows open it costs
 * nothing (and SDL is never started). Otherwise it collects events and
 * returns the number of instructions until the next poll, or -1 if the
 * user closed a window.
 *
 * Windows are shown at once whenever the program reaches a natural
 * pause: waiting in Event(), Pending() (which calls wsync), WFlush(),
 * WSync() or WDelay(). pollevent() also shows them, but only if the
 * program has been drawing for ICONSDL_FRAME_MS (default 100) without
 * such a pause: showing more often catches repaints half done (a pane
 * erased, its text not yet redrawn), which flickers.
 */
static unsigned long frame_ms(void)
   {
   static long ms = -1;
   if (ms < 0) {
      char *s = getenv("ICONSDL_FRAME_MS");
      ms = (s && atol(s) > 0) ? atol(s) : 100;
      }
   return (unsigned long)ms;
   }

int pollevent()
   {
   if (nwins == 0)
      return 400;
   if (process_events() < 0)
      return -1;
   if (millisec() - lastpresent >= frame_ms())
      present(0);
   return 400;
   }

/*
 * wopen() - open a window (as in rxwin.ri, without a display).
 */
FILE *wopen(char *name, struct b_list *lp, dptr attr, int n, int *err_index)
   {
   wbp w;
   wsp ws;
   char answer[128];
   int i;
   tended struct b_list *tlp;
   tended struct descrip attrrslt;

   tlp = lp;
   if ((w = alc_wbinding()) == NULL) {
      *err_index = -2;
      return NULL;
      }
   if ((w->window = alc_winstate()) == NULL) {
      *err_index = -2;
      free_binding(w);
      return NULL;
      }
   ws = w->window;
   ws->listp.dword = D_List;
   BlkLoc(ws->listp) = (union block *)tlp;

   if ((w->context = alc_context(w)) == NULL) {
      *err_index = -2;
      free_binding(w);
      return NULL;
      }

   /*
    * some attributes of the context determine window defaults
    */
   ws->height = FHEIGHT(w) * 12;
   ws->width  = FWIDTH(w) * 80;
   ws->y = ASCENT(w);
   ws->x = 0;
   ws->y += w->context->dy;
   ws->x += w->context->dx;

   for (i = 0; i < n; i++) {
      switch (wattrib((wbp) w, StrLoc(attr[i]), StrLen(attr[i]), &attrrslt,
		      answer)) {
      case Error:
	 *err_index = i;
	 return NULL;
      case Failed:
	 free_binding((wbp)w);
	 *err_index = -1;
	 return NULL;
	 }
      }
   if (ws->windowlabel == NULL) {
      ws->windowlabel = salloc(name);
      if (ws->windowlabel == NULL) {
	 *err_index = -2;
	 return NULL;
	 }
      }

   if ((i = wmap(w)) != Succeeded) {
      free_binding((wbp)w);
      if (i == Failed) *err_index = -1;
      else *err_index = 0;
      return NULL;
      }
   return (FILE *)w;
   }

/*
 * wclose() - close a window: the window disappears; the canvas goes
 * when its last reference does.
 */
int wclose(wbp w)
   {
   wsp ws = w->window;
   if (ws->win && ws->refcount > 1) {
      sdl_unmap(ws);
      ws->refcount--;
      }
   else
      free_window(ws);
   return 0;
   }

void wflush(wbp w) { if (nwins) present(0); }
void wsync(wbp w) { if (nwins) present(0); }

/*
 * wgetq() - get the next event for w, waiting for one if need be (and
 * showing everything drawn so far first). A hidden canvas never receives
 * an event: report it as closed rather than waiting forever.
 */
int wgetq(wbp w, dptr res)
   {
   wsp ws = w->window;
   int cx = 0, cy = 0, cw = 0, ch = 0, posted = 0;

   for (;;) {
      if (nwins && process_events() < 0)
	 return -1;
      if (!EVQUEEMPTY(w)) {
	 EVQUEGET(w, *res);
	 break;
	 }
      if (ws->win == NULL)
	 return -1;
      if (posted)			/* restore under the cursor */
	 cv_dirty(ws->canvas, cx, cy, cw, ch);
      present(0);
      /*
       * The text cursor (cursor=on), as rxwin.ri's postcursor draws it:
       * a fg bar the width of a character and the height of the descent,
       * below the text position, on the window but not in its canvas.
       */
      posted = 0;
      if (ISCURSORON(w) && ws->canvas) {
	 cx = ws->x; cy = ws->y; cw = FWIDTH(w); ch = DESCENT(w);
	 pl_overlay(ws->win, cx, cy, cw, ch, w->context->fg, cv_scale(ws->canvas));
	 posted = 1;
	 }
      pl_wait(-1);
      }
   if (posted) {			/* scrubcursor */
      cv_dirty(ws->canvas, cx, cy, cw, ch);
      present(0);
      }
   return 1;
   }

/*
 * ---------------------------------------------------------------------
 * Drawing
 * ---------------------------------------------------------------------
 */

void drawpoints(wbp w, XPoint *points, int npoints)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_points(CANVAS(w), &g, (int *)points, npoints);
   }

void drawlines(wbp w, XPoint *points, int npoints)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_lines(CANVAS(w), &g, (int *)points, npoints);
   }

void drawsegments(wbp w, XSegment *segs, int nsegs)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_segments(CANVAS(w), &g, (int *)segs, nsegs);
   }

void drawrectangles(wbp w, XRectangle *recs, int nrecs)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_rects(CANVAS(w), &g, (int *)recs, nrecs);
   }

void fillrectangles(wbp w, XRectangle *recs, int nrecs)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_fillrects(CANVAS(w), &g, (int *)recs, nrecs);
   }

static void do_arcs(wbp w, XArc *arcs, int narcs, int fill)
   {
   sdlgc g;
   int *r, i;
   double *a;
   if (!CANVAS(w) || narcs <= 0) return;
   r = malloc(narcs * 4 * sizeof(int));
   a = malloc(narcs * 2 * sizeof(double));
   if (r && a) {
      for (i = 0; i < narcs; i++) {
	 r[4*i] = arcs[i].x;
	 r[4*i+1] = arcs[i].y;
	 r[4*i+2] = arcs[i].width;
	 r[4*i+3] = arcs[i].height;
	 a[2*i] = arcs[i].angle1;
	 a[2*i+1] = arcs[i].angle2;
	 }
      mkgc(w, &g);
      cv_arcs(CANVAS(w), &g, r, a, narcs, fill);
      }
   free(r);
   free(a);
   }

void drawarcs(wbp w, XArc *a, int n) { do_arcs(w, a, n, 0); }
void fillarcs(wbp w, XArc *a, int n) { do_arcs(w, a, n, 1); }

void fillpolygon(wbp w, XPoint *pts, int npts)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_fillpoly(CANVAS(w), &g, (int *)pts, npts);
   }

/*
 * eraseArea() - fill with the background colour. As in rxwin.ri, an
 * area reaching the window's edge extends over the whole canvas.
 */
void eraseArea(wbp w, int x, int y, int width, int height)
   {
   wsp ws = w->window;
   sdlgc g;
   if (!CANVAS(w)) return;
   if (x + width >= (int)ws->width)  width  = ws->pixwidth - x;
   if (y + height >= (int)ws->height) height = ws->pixheight - y;
   mkgc(w, &g);
   cv_erase(CANVAS(w), &g, x, y, width, height);
   }

/*
 * copyArea() - copy from w's canvas to w2's, as rxwin.ri does: always in
 * copy mode (whatever w2's drawop), within w2's clip, and with any part
 * of the source beyond its canvas filled with w2's background colour
 * (after copying, in case source and destination overlap).
 */
int copyArea(wbp w, wbp w2, int x, int y, int width, int height, int x2, int y2)
   {
   wsp ws1 = w->window;
   sdlgc g;
   int lpad, rpad, tpad, bpad;

   if (!CANVAS(w) || !CANVAS(w2)) return Failed;
   mkgc(w2, &g);
   g.drawop = DRAWOP_COPY;
   g.reverse = 0;
   g.fillstyle = FS_SOLID;

   if (x + width < 0 || y + height < 0 || x >= ws1->pixwidth ||
       y >= ws1->pixheight) {		/* source entirely off the canvas */
      cv_erase(CANVAS(w2), &g, x2, y2, width, height);
      return Succeeded;
      }
   lpad = rpad = tpad = bpad = 0;
   if (x < 0) {
      lpad = -x;
      width -= lpad;
      x2 += lpad;
      x = 0;
      }
   if (x + width > ws1->pixwidth) {
      rpad = x + width - ws1->pixwidth;
      width -= rpad;
      }
   if (y < 0) {
      tpad = -y;
      height -= tpad;
      y2 += tpad;
      y = 0;
      }
   if (y + height > ws1->pixheight) {
      bpad = y + height - ws1->pixheight;
      height -= bpad;
      }
   cv_copy(CANVAS(w), CANVAS(w2), &g, x, y, width, height, x2, y2);
   if (lpad > 0)
      cv_erase(CANVAS(w2), &g, x2 - lpad, y2 - tpad, lpad, tpad + height + bpad);
   if (rpad > 0)
      cv_erase(CANVAS(w2), &g, x2 + width, y2 - tpad, rpad, tpad + height + bpad);
   if (tpad > 0)
      cv_erase(CANVAS(w2), &g, x2, y2 - tpad, width, tpad);
   if (bpad > 0)
      cv_erase(CANVAS(w2), &g, x2, y2 + height, width, bpad);
   return Succeeded;
   }

/* Clipping is read from the context on every call. */
void setclip(wbp w) { }
void unsetclip(wbp w) { }

/*
 * ---------------------------------------------------------------------
 * Text
 * ---------------------------------------------------------------------
 */

int textWidth(wbp w, char *s, int n)
   {
   return ft_width(w->context->font->face, s, n);
   }

void drawstrng(wbp w, int x, int y, char *s, int slen)
   {
   sdlgc g;
   if (!CANVAS(w)) return;
   mkgc(w, &g);
   cv_text(CANVAS(w), &g, w->context->font->face, x, y, s, slen, 0);
   }

/*
 * xdis() - draw text at the text cursor with its background (X's
 * XDrawImageString), and advance the cursor.
 */
void xdis(wbp w, char *s, int n)
   {
   wsp ws = w->window;
   sdlgc g;

   pollctr >>= 1; pollctr++;
   if (CANVAS(w)) {
      mkgc(w, &g);
      ws->x += cv_text(CANVAS(w), &g, w->context->font->face, ws->x, ws->y, s, n, 1);
      }
   else
      ws->x += textWidth(w, s, n);
   }

/*
 * wputc() - write a character to a window (as rxwin.ri: newline,
 * scrolling, tabs, and cooked-mode backspace).
 */
int wputc(int ci, wbp w)
   {
   wsp ws = w->window;
   wcp wc = w->context;
   int lh, width, height, over;
   char c = (char)ci;
   sdlgc g;

   lh = wc->leading;
   width = ws->width;
   height = ws->height;

   switch (c) {
   case '\r':
      ws->x = wc->dx;
      break;
   case '\n':
      if (ISCEOLON(w) && CANVAS(w)) {	/* clear to end of line */
	 mkgc(w, &g);
	 g.clipw = -1;
	 cv_erase(CANVAS(w), &g, ws->x, ws->y - ASCENT(w), width - ws->x, lh);
	 }
      ws->y += lh;
      ws->x = wc->dx;
      over = ws->y + DESCENT(w) - height;
      if (over > 0) {			/* scroll */
	 ws->y -= over;
	 if (CANVAS(w)) {
	    mkgc(w, &g);
	    g.drawop = DRAWOP_COPY;
	    g.reverse = 0;
	    g.clipw = -1;
	    cv_copy(CANVAS(w), CANVAS(w), &g, 0, over, width, height - over, 0, 0);
	    cv_erase(CANVAS(w), &g, 0, height - over, width, over);
	    }
	 }
      break;
   case '\t':
      xdis(w, "        ", 8 - ((XTOCOL(w, ws->x)) & 7));
      break;
   case '\177':
   case '\010': {
      int i = 0, pre_x;
      i--;
      while ((i > -EQUEUELEN) && (EVQUESUB(w, i) != c)) i--;
      if (i == -EQUEUELEN) break;
      i--;
      while ((i > -EQUEUELEN) && !isprint(EVQUESUB(w, i))) i--;
      if (i == -EQUEUELEN) break;
      c = EVQUESUB(w, i);
      pre_x = ws->x;
      ws->x -= textWidth(w, &c, 1);
      *evquesub(w, i) = '\010';
      i = ws->x;
      while (ws->x < pre_x) xdis(w, " ", 1);
      ws->x = i;
      break;
      }
   default:
      xdis(w, &c, 1);
   }
   return 1;
   }

int setfont(wbp w, char **s)
   {
   wfp f;
   Protect(f = alc_font(w, s), return Failed);
   w->context->font = f;
   if (!CANVAS(w)) {
      w->window->y = ASCENT(w);
      w->window->x = 0;
      }
   return Succeeded;
   }

void getfntnam(wbp w, char *answer) { strcpy(answer, w->context->font->name); }
int setleading(wbp w, int i) { w->context->leading = i; return Succeeded; }

/* The text cursor (WAttrib("cursor=on")): not yet drawn. */
int setcursor(wbp w, int on)
   {
   if (on) SETCURSORON(w);
   else CLRCURSORON(w);
   return Succeeded;
   }

/*
 * ---------------------------------------------------------------------
 * Colours and the graphics context
 * ---------------------------------------------------------------------
 */

int setfg(wbp w, char *s)
   {
   long r, g, b;
   if (parsecolor(w, s, &r, &g, &b) != Succeeded)
      return Failed;
   w->context->fg = sdl_rgb(w, r, g, b, s, w->context->fgname);
   return Succeeded;
   }

int setbg(wbp w, char *s)
   {
   long r, g, b;
   if (parsecolor(w, s, &r, &g, &b) != Succeeded)
      return Failed;
   w->context->bg = sdl_rgb(w, r, g, b, s, w->context->bgname);
   return Succeeded;
   }

/* Set fg or bg from a pixel value 0xRRGGBB (or a mutable colour, < 0). */
static int isetcolor(wbp w, int c, int fg)
   {
   char s[MaxCvtLen];
   if (c < 0)
      return Failed;			/* no mutable colours */
   sprintf(s, "%d,%d,%d", ((c >> 16) & 255) * 257, ((c >> 8) & 255) * 257,
      (c & 255) * 257);
   return fg ? setfg(w, s) : setbg(w, s);
   }

int isetfg(wbp w, int fg) { return isetcolor(w, fg, 1); }
int isetbg(wbp w, int bg) { return isetcolor(w, bg, 0); }

void getfg(wbp w, char *answer) { strcpy(answer, w->context->fgname); }
void getbg(wbp w, char *answer) { strcpy(answer, w->context->bgname); }

void toggle_fgbg(wbp w)
   {
   wcp wc = w->context;
   unsigned long t = wc->fg;
   char tn[6 + MAXCOLORNAME];
   wc->fg = wc->bg;
   wc->bg = t;
   strcpy(tn, wc->fgname);
   strcpy(wc->fgname, wc->bgname);
   strcpy(wc->bgname, tn);
   }

int setgamma(wbp w, double gamma)
   {
   char fg[6 + MAXCOLORNAME], bg[6 + MAXCOLORNAME];
   w->context->gamma = gamma;
   strcpy(fg, w->context->fgname);		/* reinterpret fg and bg */
   strcpy(bg, w->context->bgname);
   setfg(w, fg);
   setbg(w, bg);
   return Succeeded;
   }

/*
 * nativecolor() - X's colour names (rgb.txt), for names Icon's own
 * colour phrases don't cover. As XParseColor gives 16-bit values (the
 * 8-bit ones times 257), converted to linear Icon colour as rxwin.ri's
 * lcolor() does.
 */
int nativecolor(wbp w, char *s, long *r, long *g, long *b)
   {
   int R, G, B;
   double gamma;
   if (!w || !xcolor_lookup(s, &R, &G, &B))
      return 0;
   gamma = w->context->gamma;
   *r = 65535 * pow((R * 257) / 65535.0, gamma);
   *g = 65535 * pow((G * 257) / 65535.0, gamma);
   *b = 65535 * pow((B * 257) / 65535.0, gamma);
   return 1;
   }

void freecolor(wbp w, char *s) { }

/* Mutable colours are not supported (sdl/design.md, decision 1). */
int mutable_color(wbp w, dptr argv, int ac, int *retval) { return Failed; }
int set_mutable(wbp w, int i, char *s) { return Failed; }
char *get_mutable_name(wbp w, int mute_index) { return NULL; }
void free_mutable(wbp w, int mute_index) { }

int setdrawop(wbp w, char *val)
   {
   wcp wc = w->context;
   int op;
   if (!strcmp(val, "reverse")) {
      SETXORREVERSE(w);
      wc->drawop = DRAWOP_XOR;
      return Succeeded;
      }
   op = si_s2i(drawops, val);
   if (op == -1)
      return Error;
   CLRXORREVERSE(w);
   wc->drawop = op;
   return Succeeded;
   }

void getdrawop(wbp w, char *answer)
   {
   char *s;
   if (ISXORREVERSE(w))
      s = "reverse";
   else
      s = si_i2s(drawops, w->context->drawop);
   strcpy(answer, s ? s : "copy");
   }

int setlinestyle(wbp w, char *s)
   {
   wcp wc = w->context;
   if (!strcmp(s, "solid"))
      wc->linestyle = LS_SOLID;
   else if (!strcmp(s, "onoff") || !strcmp(s, "dashed"))
      wc->linestyle = LS_DASHED;
   else if (!strcmp(s, "doubledash") || !strcmp(s, "striped"))
      wc->linestyle = LS_STRIPED;
   else
      return Error;
   return Succeeded;
   }

void getlinestyle(wbp w, char *answer)
   {
   wcp wc = w->context;
   strcpy(answer, wc->linestyle == LS_SOLID ? "solid" :
      (wc->linestyle == LS_DASHED ? "dashed" : "striped"));
   }

int setlinewidth(wbp w, LONG linewid)
   {
   if (linewid > 32767)
      return Failed;
   w->context->linewidth = linewid;
   return Succeeded;
   }

int setfillstyle(wbp w, char *s)
   {
   wcp wc = w->context;
   if (!strcmp(s, "solid"))
      wc->fillstyle = FS_SOLID;
   else if (!strcmp(s, "masked") || !strcmp(s, "stippled")
	    || !strcmp(s, "patterned"))
      wc->fillstyle = FS_STIPPLE;
   else if (!strcmp(s, "textured") || !strcmp(s, "opaquestippled")
	    || !strcmp(s, "opaquepatterned"))
      wc->fillstyle = FS_OPAQUESTIPPLE;
   else
      return Error;
   return Succeeded;
   }

/*
 * SetPatternBits() - set the fill pattern: nbits rows of width bits,
 * bit x of row y (least significant first) setting pixel x, as X's
 * XCreateBitmapFromData reads them.
 */
int SetPatternBits(wbp w, int width, C_integer *bits, int nbits)
   {
   wcp wc = w->context;
   unsigned char *p;
   int x, y;

   if (width <= 0 || nbits <= 0)
      return Failed;
   p = malloc(width * nbits);
   if (p == NULL)
      ReturnErrNum(305, Error);
   for (y = 0; y < nbits; y++)
      for (x = 0; x < width; x++)
	 p[y * width + x] = (x < (int)(8 * sizeof(C_integer)))
	    ? (bits[y] >> x) & 1 : 0;
   if (wc->pat)
      free(wc->pat);
   wc->pat = p;
   wc->patw = width;
   wc->path = nbits;
   return Succeeded;
   }

int SetPattern(wbp w, char *name, int len)
   {
   wcp wc = w->context;
   int width, nbits, i, symbol;
   C_integer bits[MAXXOBJS];

   if (wc->patternname != NULL)
      free(wc->patternname);
   wc->patternname = malloc(len + 1);
   if (wc->patternname == NULL)
      ReturnErrNum(305, Error);
   strncpy(wc->patternname, name, len);
   wc->patternname[len] = '\0';

   if (len > 0 && isdigit(name[0])) {	/* width,bits encoding */
      nbits = MAXXOBJS;
      switch (parsepattern(name, len, &width, &nbits, bits)) {
      case Failed:
	 return Failed;
      case Error:
	 ReturnErrNum(145, Error);
	 }
      return SetPatternBits(w, width, bits, nbits);
      }

   if ((symbol = si_s2i(siPatternSyms, wc->patternname)) >= 0) {
      for (i = 0; i < 8; i++)
	 bits[i] = patbits[symbol * 8 + i];
      return SetPatternBits(w, 8, bits, 8);
      }
   return Failed;
   }

int rebind(wbp w, wbp w2)
   {
   w->context = w2->context;
   return Succeeded;
   }

/*
 * ---------------------------------------------------------------------
 * Images and pixels
 * ---------------------------------------------------------------------
 */

/*
 * strimage() - draw a character-per-pixel image (DrawImage, GIF files).
 * Returns the number of colours that could not be allocated (always 0),
 * or -1 on error.
 */
int strimage(wbp w, int x, int y, int width, int height,
   struct palentry *e, unsigned char *s, word len, int on_icon)
   {
   unsigned int pix[256], *px;
   unsigned char *op;
   int c, v, ix, iy, n = width * height;
   sdlgc g;

   if (on_icon || !CANVAS(w))
      return 0;
   if (n <= 0)
      return 0;
   for (c = 0; c < 256; c++)
      if (e[c].used && e[c].valid) {
	 char tmp[24];			/* named as rxwin.ri's strimage does */
	 sprintf(tmp, "%ld,%ld,%ld", e[c].clr.red, e[c].clr.green, e[c].clr.blue);
	 pix[c] = sdl_rgb(w, e[c].clr.red, e[c].clr.green, e[c].clr.blue, tmp, NULL);
	 }
   px = calloc(n, sizeof(unsigned int));
   op = calloc(n, 1);
   if (!px || !op) {
      free(px);
      free(op);
      return -1;
      }
   ix = iy = 0;
   while (len-- && iy < height) {
      c = *s++;
      v = e[c].valid;
      if (v) {
	 px[iy * width + ix] = pix[c];
	 op[iy * width + ix] = 1;
	 }
      if (v || e[c].transpt) {
	 if (++ix >= width) {
	    ix = 0;
	    iy++;
	    }
	 }
      }
   if (ix > 0)				/* pad final row with bg */
      while (ix < width) {
	 px[iy * width + ix] = w->context->bg;
	 op[iy * width + ix++] = 1;
	 }
   mkgc(w, &g);
   cv_write(CANVAS(w), &g, x, y, width, height, px, op);
   free(px);
   free(op);
   return 0;
   }

/*
 * blimage() - draw a bilevel image ("width,#hex" or "width,~hex").
 * The hex digits fill each row right to left, as in rxwin.ri.
 */
int blimage(wbp w, int x, int y, int width, int height,
   int ch, unsigned char *s, word len)
   {
   unsigned int m, msk1, c, ix, iy, *px, fg, bg;
   unsigned char *op;
   int n = width * height;
   sdlgc g;

   if (!CANVAS(w) || n <= 0)
      return Succeeded;
   px = calloc(n, sizeof(unsigned int));
   op = calloc(n, 1);
   if (!px || !op) {
      free(px);
      free(op);
      return Error;
      }
   m = width % 4;
   msk1 = (m == 0) ? 8 : 1 << (m - 1);
   fg = w->context->fg;
   bg = w->context->bg;
   ix = width;
   iy = 0;
   m = msk1;
   while (len-- && iy < (unsigned)height) {
      if (isxdigit(c = *s++)) {
	 if (!isdigit(c))
	    c += 9;
	 while (m > 0) {
	    --ix;
	    if (c & m) {
	       px[iy * width + ix] = fg;
	       op[iy * width + ix] = 1;
	       }
	    else if (ch != TCH1) {
	       px[iy * width + ix] = bg;
	       op[iy * width + ix] = 1;
	       }
	    m >>= 1;
	    }
	 if (ix == 0) {
	    ix = width;
	    iy++;
	    m = msk1;
	    }
	 else
	    m = 8;
	 }
      }
   if (ix > 0 && ix < (unsigned)width && iy < (unsigned)height)
      while (ix < (unsigned)width) {	/* pad final row */
	 px[iy * width + ix] = bg;
	 op[iy * width + ix++] = 1;
	 }
   mkgc(w, &g);
   cv_write(CANVAS(w), &g, x, y, width, height, px, op);
   free(px);
   free(op);
   return Succeeded;
   }

/*
 * capture() - the region as 15-bit linear colour, for writeGIF, mapping
 * each 8-bit channel through gamma exactly as rxwin.ri does.
 */
int capture(wbp w, int x, int y, int width, int height, short *data)
   {
   unsigned char cmap[256];
   unsigned int *px, p;
   double gamma = w->context->gamma;
   int i, n = width * height;

   if (!CANVAS(w))
      return 0;
   px = malloc(n * sizeof(unsigned int));
   if (!px)
      return 0;
   cv_read(CANVAS(w), x, y, width, height, w->context->bg, px);
   for (i = 0; i < 256; i++)
      cmap[i] = 31 * pow(i / 255., gamma) + 0.5;
   for (i = 0; i < n; i++) {
      p = px[i];
      *data++ = (cmap[(p >> 16) & 0xFF] << 10) | (cmap[(p >> 8) & 0xFF] << 5)
	 | cmap[p & 0xFF];
      }
   free(px);
   return 1;
   }

int getpixel_init(wbp w, struct imgmem *imem)
   {
   imem->pix = NULL;
   if (imem->width <= 0 || imem->height <= 0 || !CANVAS(w))
      return Succeeded;
   imem->pix = malloc(imem->width * imem->height * sizeof(unsigned int));
   if (imem->pix == NULL)
      return Failed;
   cv_read(CANVAS(w), imem->x, imem->y, imem->width, imem->height,
      w->context->bg, imem->pix);
   return Succeeded;
   }

int getpixel_term(wbp w, struct imgmem *imem)
   {
   if (imem->pix)
      free(imem->pix);
   imem->pix = NULL;
   return Succeeded;
   }

int getpixel(wbp w, int x, int y, long *rv, char *s, struct imgmem *imem)
   {
   unsigned int c;
   long r, g, b;

   if (!imem->pix || x < imem->x || x >= imem->x + imem->width ||
       y < imem->y || y >= imem->y + imem->height)
      c = w->context->bg;
   else
      c = imem->pix[(y - imem->y) * imem->width + (x - imem->x)];
   sdl_lcolor(w, c, &r, &g, &b);
   *rv = 1;
   sprintf(s, "%ld,%ld,%ld", r, g, b);
   return Succeeded;
   }

/*
 * readimage() - ReadImage() for formats src/sdl reads (PNG, JPEG, BMP,
 * QOI; GIF is handled by the generic code first). File pixels are device
 * colours; alpha < 50% is transparent.
 */
int readimage(wbp w, char *filename, int x, int y, int *status)
   {
   unsigned int *px;
   unsigned char *op;
   int iw, ih, i;
   sdlgc g;

   *status = 0;
   px = cv_load(filename, &iw, &ih);
   if (px == NULL)
      return Failed;
   op = malloc(iw * ih);
   if (op == NULL) {
      free(px);
      return Error;
      }
   for (i = 0; i < iw * ih; i++)
      op[i] = (px[i] >> 24) >= 128;
   if (CANVAS(w)) {
      mkgc(w, &g);
      cv_write(CANVAS(w), &g, x, y, iw, ih, px, op);
      }
   free(px);
   free(op);
   return Succeeded;
   }

/*
 * dumpimage() - WriteImage() for PNG, JPEG, BMP and QOI; NoCvt sends
 * anything else (GIF) to the generic writeGIF.
 */
int dumpimage(wbp w, char *filename, unsigned int x, unsigned int y,
   unsigned int width, unsigned int height)
   {
   int r;
   if (!CANVAS(w))
      return Failed;
   r = cv_save(CANVAS(w), filename, x, y, width, height);
   if (r < 0)
      return NoCvt;
   return r ? Succeeded : Failed;
   }

/*
 * setimage() - the image= attribute for a file the generic code could
 * not read as GIF: read it now, size the window, draw it when mapped.
 */
int setimage(wbp w, char *val)
   {
   wsp ws = w->window;
   int iw, ih;
   unsigned int *px = cv_load(val, &iw, &ih);
   if (px == NULL)
      return Failed;
   if (ws->initpix)
      free(ws->initpix);
   ws->initpix = px;
   ws->initw = iw;
   ws->inith = ih;
   ws->width = iw;
   ws->height = ih;
   return Succeeded;
   }

/*
 * ---------------------------------------------------------------------
 * Window geometry and state
 * ---------------------------------------------------------------------
 */

int setwidth(wbp w, SHORT new_width)
   {
   if (new_width < 0) return Failed;
   w->window->width = new_width;
   return Succeeded;
   }

int setheight(wbp w, SHORT new_height)
   {
   if (new_height < 0) return Failed;
   w->window->height = new_height;
   return Succeeded;
   }

int setgeometry(wbp w, char *geo)
   {
   wsp ws = w->window;
   SHORT width = 0, height = 0, x = 0, y = 0;
   int status;

   if ((status = parsegeometry(geo, &x, &y, &width, &height)) == 0)
      return Error;
   if (status & 1) {
      ws->width = width;
      ws->height = height;
      }
   if ((ws->win || !ws->canvas) && (status & 2)) {
      ws->posx = x;
      ws->posy = y;
      }
   return Succeeded;
   }

/*
 * do_config() - apply a new size (and, for windows, position): the
 * canvas grows as needed, never shrinks (like X's backing pixmap).
 */
int do_config(wbp w, int status)
   {
   wsp ws = w->window;
   int x, y;
   if (ws->canvas) {
      cv_resize(ws->canvas, ws->width, ws->height, w->context->bg);
      if ((int)ws->width > ws->pixwidth) ws->pixwidth = ws->width;
      if ((int)ws->height > ws->pixheight) ws->pixheight = ws->height;
      }
   if (ws->win) {
      x = (status == 2 || ws->posx == -(MaxInt)) ? PL_NOPOS : ws->posx;
      y = (status == 2 || ws->posy == -(MaxInt)) ? PL_NOPOS : ws->posy;
      if (status == 1)
	 pl_geometry(ws->win, x, y, 0, 0);
      else
	 pl_geometry(ws->win, x, y, ws->width, ws->height);
      pl_present(ws->win, ws->canvas, ws->width, ws->height, 1);
      }
   return Succeeded;
   }

int allowresize(wbp w, int on)
   {
   if (on) SETRESIZABLE(w);
   else CLRRESIZABLE(w);
   if (w->window->win)
      pl_resizable(w->window->win, on);
   return Succeeded;
   }

int getpos(wbp w)
   {
   wsp ws = w->window;
   int x, y;
   if (ws->win && pl_position(ws->win, &x, &y)) {
      ws->posx = x;
      ws->posy = y;
      }
   return Succeeded;
   }

/*
 * setcanvas() - hidden, normal, iconic (minimised) or maximal. Showing a
 * hidden canvas makes its window then (the canvas keeps its scale).
 */
int setcanvas(wbp w, char *s)
   {
   wsp ws = w->window;
   int state, scale;

   if (!strcmp(s, "hidden")) state = HiddenState;
   else if (!strcmp(s, "normal")) state = NormalState;
   else if (!strcmp(s, "iconic")) state = IconicState;
   else if (!strcmp(s, "maximal")) state = MaximizedState;
   else return Error;

   ws->iconic = state;
   if (ws->canvas == NULL)		/* not yet mapped: wmap does it */
      return Succeeded;
   if (state == HiddenState) {
      if (ws->win)
	 pl_state(ws->win, PL_HIDDEN);
      return Succeeded;
      }
   if (ws->win == NULL) {
      if (mkwin(w, &scale) != Succeeded)
	 return Failed;
      showwin(w);
      }
   else
      pl_state(ws->win, plstate(state));
   return Succeeded;
   }

void getcanvas(wbp w, char *s)
   {
   switch (w->window->iconic) {
   case HiddenState:	strcpy(s, "hidden"); break;
   case IconicState:	strcpy(s, "iconic"); break;
   case MaximizedState:	strcpy(s, "maximal"); break;
   default:		strcpy(s, "normal"); break;
   }
   }

int seticonicstate(wbp w, char *s) { return setcanvas(w, s); }
void geticonic(wbp w, char *answer)
   {
   sprintf(answer, "%d", w->window->iconic == IconicState);
   }
int seticonlabel(wbp w, char *val)
   {
   if (w->window->iconlabel) free(w->window->iconlabel);
   w->window->iconlabel = salloc(val);
   return Succeeded;
   }
/*
 * seticonimage() - iconimage=: another window's contents, or an image
 * file (GIF, read by Icon's own reader; or PNG, JPEG, BMP, QOI). It
 * becomes the window's icon (on macOS, the application's Dock icon).
 */
int seticonimage(wbp w, dptr dp)
   {
   wsp ws = w->window;
   unsigned int *px = NULL;
   int iw = 0, ih = 0, i;
   char *name;
   tended char *tmp;
   struct imgdata imd;

   if (is:file(*dp) && (BlkLoc(*dp)->file.status & Fs_Window)) {
      wbp x = (wbp)BlkLoc(*dp)->file.fd;
      if (!x->window->canvas)
	 return Failed;
      iw = x->window->width;
      ih = x->window->height;
      px = malloc(iw * ih * sizeof(unsigned int));
      if (!px)
	 ReturnErrNum(305, Error);
      cv_read(x->window->canvas, 0, 0, iw, ih, x->context->bg, px);
      for (i = 0; i < iw * ih; i++)
	 px[i] |= 0xFF000000u;
      name = x->window->windowlabel;
      }
   else if (is:string(*dp)) {
      if (!cnv:C_string(*dp, tmp))
	 ReturnErrVal(103, *dp, Error);
      name = tmp;
      if (readGIF(tmp, 0, &imd) == Succeeded) {
	 iw = imd.width;
	 ih = imd.height;
	 px = malloc(iw * ih * sizeof(unsigned int));
	 if (px)
	    for (i = 0; i < iw * ih; i++) {
	       struct palentry *e = &imd.paltbl[imd.data[i]];
	       px[i] = e->valid ? 0xFF000000u |
		  sdl_rgb(w, e->clr.red, e->clr.green, e->clr.blue, NULL, NULL) : 0;
	       }
	 free((pointer)imd.paltbl);
	 free((pointer)imd.data);
	 }
      else
	 px = cv_load(tmp, &iw, &ih);
      if (!px)
	 return Failed;
      }
   else
      return Error;

   if (ws->iconimage) free(ws->iconimage);
   ws->iconimage = salloc(name ? name : "");
   if (ws->iconpx) free(ws->iconpx);
   ws->iconpx = px;
   ws->iconpw = iw;
   ws->iconph = ih;
   if (ws->win)
      pl_icon(ws->win, px, iw, ih);
   return Succeeded;
   }
int setwindowlabel(wbp w, char *val)
   {
   if (w->window->windowlabel) free(w->window->windowlabel);
   w->window->windowlabel = salloc(val);
   if (w->window->win)
      pl_title(w->window->win, val);
   return Succeeded;
   }
int seticonpos(wbp w, char *s) { return Failed; }
int geticonpos(wbp w, char *s) { return Failed; }
int raiseWindow(wbp w)
   {
   if (w->window->win)
      pl_raise(w->window->win);
   return Succeeded;
   }
int lowerWindow(wbp w)
   {
   if (w->window->win)
      pl_lower(w->window->win);
   return Succeeded;
   }
int walert(wbp w, int volume) { pl_beep(volume); return Succeeded; }

