/*
 * File: rsdlwin.ri - SDL3 + Blend2D graphics backend
 * (icon-sdl fork; MIT licence, see LICENSE.md).
 *
 * This file implements the interface rwindow.r and fwindow.r expect of a
 * window system (see the "graphics implementation routines" in
 * rproto.h). It is processed by rtt, so it uses only plain C; everything
 * that touches SDL or Blend2D is in src/sdl behind sdlgfx.h.
 *
 * STATUS: skeleton. The configuration builds and links against SDL3 and
 * Blend2D, but no window can be opened yet: wopen() fails, so none of
 * the other routines can be reached. They are placeholders, to be
 * replaced as the canvas and platform layers are ported from the
 * prototype (see sdl/design.md).
 */

#include "../sdl/sdlgfx.h"

/*
 * pollevent() is called by the interpreter every few hundred
 * instructions in any graphics build; with no windows open it must cost
 * nothing (and must not start SDL). Returns the number of instructions
 * until the next poll.
 */
int pollevent()
   {
   return 400;
   }

/*
 * wopen() - open a window. Not yet implemented: fail, after checking that
 * SDL3 and Blend2D are linked and working.
 */
FILE *wopen(char *name, struct b_list *lp, dptr attr, int n, int *err_index)
   {
   *err_index = -1;			/* plain failure, not an error */
   if (sdlgfx_probe() == 0)
      return NULL;
   return NULL;
   }

