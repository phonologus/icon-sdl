/*
 * File: rsdlwin.ri - SDL3 + Blend2D graphics backend
 * (icon-sdl fork; MIT licence, see LICENSE.md).
 *
 * This file implements the interface rwindow.r and fwindow.r expect of a
 * window system (the "graphics implementation routines" in rproto.h),
 * following rxwin.ri function by function. It is processed by rtt, so it
 * uses only plain C; everything that touches SDL or Blend2D is in src/sdl
 * behind ../sdl/sdlgfx.h.
 *
 * Each window state owns a canvas (the pixels, the equivalent of X's
 * backing pixmap). Drawing goes to the canvas; a visible window shows it.
 *
 * A window state with a window also has a platform window (src/sdl
 * plat.c), which shows the canvas; the platform layer runs SDL on the
 * process's main thread and queues translated events, which pollevent()
 * and wgetq() move into Icon's event lists.
 */

#include "../sdl/sdlgfx.h"

