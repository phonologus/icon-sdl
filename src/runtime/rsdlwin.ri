   {"equiv",		DRAWOP_EQUIV},
   {"invert",		DRAWOP_INVERT},
   {"nand",		DRAWOP_NAND},
   {"noop",		DRAWOP_NOOP},
   {"nor",		DRAWOP_NOR},
