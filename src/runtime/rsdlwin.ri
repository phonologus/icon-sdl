/*
 * Pointer shapes: X's cursor-font names, mapped to the nearest of SDL's
 * system cursors (SDL_SystemCursor values). Any other name fails, as in
 * X.
 */
static stringint cursorsyms[] = {
  { 0, 78},
  {"X cursor", PLC_NO}, {"arrow", PLC_DEFAULT},
  {"based arrow down", PLC_NS}, {"based arrow up", PLC_NS},
  {"boat", PLC_DEFAULT}, {"bogosity", PLC_NO},
  {"bottom left corner", PLC_SW}, {"bottom right corner", PLC_SE},
  {"bottom side", PLC_S}, {"bottom tee", PLC_DEFAULT},
  {"box spiral", PLC_WAIT}, {"center ptr", PLC_DEFAULT},
  {"circle", PLC_NO}, {"clock", PLC_WAIT}, {"coffee mug", PLC_WAIT},
  {"cross", PLC_CROSSHAIR}, {"cross reverse", PLC_CROSSHAIR},
  {"crosshair", PLC_CROSSHAIR}, {"diamond cross", PLC_CROSSHAIR},
  {"dot", PLC_DEFAULT}, {"dotbox", PLC_DEFAULT}, {"double arrow", PLC_NS},
  {"draft large", PLC_DEFAULT}, {"draft small", PLC_DEFAULT},
  {"draped box", PLC_DEFAULT}, {"exchange", PLC_DEFAULT},
  {"fleur", PLC_MOVE}, {"gobbler", PLC_DEFAULT}, {"gumby", PLC_DEFAULT},
  {"hand1", PLC_POINTER}, {"hand2", PLC_POINTER}, {"heart", PLC_DEFAULT},
  {"icon", PLC_DEFAULT}, {"iron cross", PLC_CROSSHAIR},
  {"left ptr", PLC_DEFAULT}, {"left side", PLC_W},
  {"left tee", PLC_DEFAULT}, {"leftbutton", PLC_DEFAULT},
  {"ll angle", PLC_DEFAULT}, {"lr angle", PLC_DEFAULT},
  {"man", PLC_DEFAULT}, {"middlebutton", PLC_DEFAULT},
  {"mouse", PLC_DEFAULT}, {"num glyphs", PLC_DEFAULT},
  {"pencil", PLC_CROSSHAIR}, {"pirate", PLC_NO},
  {"plus", PLC_CROSSHAIR}, {"question arrow", PLC_DEFAULT},
  {"right ptr", PLC_DEFAULT}, {"right side", PLC_E},
  {"right tee", PLC_DEFAULT}, {"rightbutton", PLC_DEFAULT},
  {"rtl logo", PLC_DEFAULT}, {"sailboat", PLC_DEFAULT},
  {"sb down arrow", PLC_NS}, {"sb h double arrow", PLC_EW},
  {"sb left arrow", PLC_EW}, {"sb right arrow", PLC_EW},
  {"sb up arrow", PLC_NS}, {"sb v double arrow", PLC_NS},
  {"shuttle", PLC_DEFAULT}, {"sizing", PLC_MOVE}, {"spider", PLC_DEFAULT},
  {"spraycan", PLC_DEFAULT}, {"star", PLC_DEFAULT},
  {"target", PLC_CROSSHAIR}, {"tcross", PLC_CROSSHAIR},
  {"top left arrow", PLC_DEFAULT}, {"top left corner", PLC_NW},
  {"top right corner", PLC_NE}, {"top side", PLC_N},
  {"top tee", PLC_DEFAULT}, {"trek", PLC_DEFAULT},
  {"ul angle", PLC_DEFAULT}, {"umbrella", PLC_DEFAULT},
  {"ur angle", PLC_DEFAULT}, {"watch", PLC_WAIT}, {"xterm", PLC_TEXT},
};

int setpointer(wbp w, char *val)
   {
   wsp ws = w->window;
   int c = si_s2i(cursorsyms, val);
   if (c < 0)
      return Failed;
   if (ws->cursorname) free(ws->cursorname);
   ws->cursorname = salloc(val);
   if (ws->win)
      pl_cursor(ws->win, c);
   return Succeeded;
   }

void getpointername(wbp w, char *answer)
   {
   strcpy(answer, w->window->cursorname ? w->window->cursorname : "left ptr");
   }

void warpPointer(wbp w, int x, int y)
   {
   if (w->window->win)
      pl_warp(w->window->win, x, y);
   }

int query_pointer(wbp w, XPoint *pp)
   {
   pp->x = w->window->pointerx;
   pp->y = w->window->pointery;
   return Succeeded;
   }

int query_rootpointer(XPoint *pp)
   {
   int x, y;
   if (!pl_global_mouse(&x, &y))
      return Failed;
   pp->x = x;
   pp->y = y;
   return Succeeded;
   }

int setdisplay(wbp w, char *s) { return Failed; }
void getdisplay(wbp w, char *answer) { *answer = '\0'; }
int getvisual(wbp w, char *answer)
   {
   strcpy(answer, "4,8,256");		/* TrueColor, 8 bits, 256 entries */
   return Succeeded;
   }
int getdefault(wbp w, char *prog, char *opt, char *answer) { return Failed; }
int displayHeight(wbp w)
   {
   int dw = 0, dh = 0;
   pl_display_size(w->window->win, &dw, &dh);
   return dh;
   }
int displayWidth(wbp w)
   {
   int dw = 0, dh = 0;
   pl_display_size(w->window->win, &dw, &dh);
   return dw;
   }
